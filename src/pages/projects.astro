---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import RunningHeader from '../components/RunningHeader.astro';
import ProjectArticle from '../components/ProjectArticle.astro';
import ContactFooter from '../components/ContactFooter.astro';
import { portfolio, assertPortfolio } from '../data/portfolio';

assertPortfolio(portfolio);

const projectCountLabel = String(portfolio.projects.length).padStart(2, '0');
---

<BaseLayout
  title={`Projects — ${portfolio.displayName}`}
  description={`All ${portfolio.projects.length} selected software and AI engineering projects by ${portfolio.displayName}.`}
  expectId="projects-page-heading"
>
  <SiteNav homePrefix="/" currentPage="projects" />
  <main id="main-content">
    <section id="projects" class="py-12 sm:py-16 md:py-24">
      <div class="container-editorial">
        <RunningHeader right={`01 — ${projectCountLabel} All Projects`} />

        <div class="mt-8 md:mt-12">
          <a
            href="/"
            class="inline-flex min-h-[44px] items-center text-sm text-ink-secondary underline decoration-ink-secondary/60 underline-offset-4 transition-colors duration-150 hover:text-ink active:opacity-75"
          >
            Back to home
          </a>

          <h1 id="projects-page-heading" class="mt-6 text-page-title text-ink">
            Projects
          </h1>
          <p class="mt-4 max-w-[56ch] text-base leading-[1.6] text-ink-secondary">
            Client, production, and independent projects across full-stack web systems and applied
            AI.
          </p>
        </div>

        <div class="mt-12 space-y-20 border-t border-rule pt-12 md:mt-16 md:space-y-32 md:pt-16">
          {portfolio.projects.map((project, idx) => (
            <ProjectArticle
              project={project}
              showDivider={idx > 0}
              headingLevel="h2"
              deferRender={idx > 0}
            />
          ))}
        </div>
      </div>
    </section>
  </main>
  <ContactFooter />
</BaseLayout>
