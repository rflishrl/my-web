---
import fs from 'node:fs';
import path from 'node:path';
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import portraitImg from '../assets/portrait.jpg';
import { portfolio } from '../data/portfolio';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  expectId?: string;
}

const {
  title = `${portfolio.displayName} — ${portfolio.headline}`,
  description = `${portfolio.displayName}, ${portfolio.headline} based in ${portfolio.location}. Full-stack web systems and production AI/LLM engineering.`,
  noindex = false,
  expectId,
} = Astro.props;

const canonicalUrl = new URL(
  Astro.url.pathname === '/' ? '/' : Astro.url.pathname,
  Astro.site,
).toString();
const ogImageExists = fs.existsSync(path.join(process.cwd(), 'public/og-image.png'));
const ogImageUrl = ogImageExists ? new URL('/og-image.png', Astro.site).toString() : undefined;

const jsonLdHtml = !noindex
  ? await (async () => {
      const optimizedPortrait = await getImage({
        src: portraitImg,
        width: 832,
        format: 'webp',
        quality: 80,
      });
      const personImageUrl = new URL(optimizedPortrait.src, Astro.site).toString();
      const jsonLd = {
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: portfolio.displayName,
        alternateName: portfolio.legalName,
        jobTitle: portfolio.headline,
        url: new URL('/', Astro.site).toString(),
        image: personImageUrl,
        sameAs: portfolio.profiles.map((profile) => profile.url),
        alumniOf: portfolio.education.map((edu) => ({
          '@type': 'EducationalOrganization',
          name: edu.institution,
        })),
        knowsAbout: portfolio.stackGroups.flatMap((group) => group.items),
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Malang',
          addressCountry: 'Indonesia',
        },
      };
      return JSON.stringify(jsonLd).replace(/</g, '\\u003c');
    })()
  : null;

const speculationRulesHtml = JSON.stringify({
  prerender: [
    {
      where: {
        and: [{ href_matches: '/*' }, { not: { selector_matches: "[href*='#']" } }],
      },
      eagerness: 'moderate',
    },
  ],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="text-scale" content="scale" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={interLatinWoff2} as="font" type="font/woff2" crossorigin />
    {expectId && <link rel="expect" href={`#${expectId}`} blocking="render" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && <meta property="og:image:alt" content={title} />}
    <meta name="twitter:card" content={ogImageExists ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    {jsonLdHtml && <script is:inline type="application/ld+json" set:html={jsonLdHtml} />}
    {!noindex && <script is:inline type="speculationrules" set:html={speculationRulesHtml} />}
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>
    <slot />
    {!noindex && <script>
      import { formatPortfolioDate } from '../utils/date';

      const yearEls = document.querySelectorAll<HTMLElement>('[data-live-year]');
      const monthYearEls = document.querySelectorAll<HTMLTimeElement>('[data-live-month-year]');
      if (yearEls.length > 0 || monthYearEls.length > 0) {
        const { year, monthYear, isoMonth } = formatPortfolioDate();

        for (const el of yearEls) {
          if (el.textContent !== year) el.textContent = year;
        }
        for (const el of monthYearEls) {
          if (el.textContent !== monthYear) el.textContent = monthYear;
          el.dateTime = isoMonth;
        }
      }
    </script>}
  </body>
</html>
