---
import type { ArchitectureDiagramData } from '../data/portfolio';

interface Props {
  diagram: ArchitectureDiagramData;
}

const { diagram } = Astro.props;
const zoomMediaQuery = '(max-width: 63.999em), (any-pointer: coarse)';
const slug = diagram.title
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '');
const inlineArrowId = `arrow-${slug}-inline`;
const descId = `diagram-desc-${slug}`;

const nodeById = new Map(diagram.nodes.map((node) => [node.id, node]));
const outCountByFrom: Record<string, number> = {};
for (const edge of diagram.edges) {
  outCountByFrom[edge.from] = (outCountByFrom[edge.from] ?? 0) + 1;
}

const nodesText = diagram.nodes
  .map((n) => (n.sublabel ? `${n.label} (${n.sublabel})` : n.label))
  .join('; ');
const edgesText = diagram.edges
  .map((e) => {
    const from = nodeById.get(e.from)?.label ?? e.from;
    const to = nodeById.get(e.to)?.label ?? e.to;
    return e.label ? `${from} to ${to} via ${e.label}` : `${from} to ${to}`;
  })
  .join('; ');
const diagramSummary = `Components: ${nodesText}. Data flow: ${edgesText}.`;

const renderedEdges = diagram.edges.flatMap((edge) => {
  const from = nodeById.get(edge.from);
  const to = nodeById.get(edge.to);
  if (!from || !to) return [];
  const x1 = from.x + from.w;
  const y1 = from.y + from.h / 2;
  const x2 = to.x;
  const y2 = to.y + to.h / 2;
  const isSingleStraight = (outCountByFrom[edge.from] ?? 0) === 1 && y1 === y2;
  const midX = isSingleStraight ? Math.round((x1 + x2) / 2) : x1 + 24;
  const labelX = isSingleStraight ? midX : Math.round((midX + x2 - 8) / 2);
  const labelY = y2 - 8;
  return [{ ...edge, x1, y1, x2, y2, midX, labelX, labelY }];
});
---

<figure
  class="mt-10 md:mt-14"
  data-diagram-figure
  data-zoom-query={zoomMediaQuery}
  data-diagram-title={diagram.title}
  data-diagram-width={diagram.width}
  data-diagram-height={diagram.height}
  data-diagram-desc={descId}
  data-diagram-slug={slug}
  data-arrow-id={inlineArrowId}
>
  <div class="rounded-[24px] bg-surface p-5 sm:p-8 md:p-12" data-diagram-host>
    <svg
      role="img"
      viewBox={`0 0 ${diagram.width} ${diagram.height}`}
      class="diagram-svg h-auto w-full"
      aria-label={diagram.title}
      aria-describedby={descId}
    >
      <title>{diagram.title}</title>
      <defs>
        <marker
          id={inlineArrowId}
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" class="diagram-marker"></path>
        </marker>
      </defs>

      {renderedEdges.map((edge) => (
        <g>
          <path
            d={`M ${edge.x1} ${edge.y1} L ${edge.midX} ${edge.y1} L ${edge.midX} ${edge.y2} L ${edge.x2} ${edge.y2}`}
            class="diagram-edge"
            stroke-width="1.5"
            marker-end={`url(#${inlineArrowId})`}
          />
          {edge.label && (
            <text
              x={edge.labelX}
              y={edge.labelY}
              text-anchor="middle"
              class="diagram-sublabel"
              font-size="10.5"
              font-family="JetBrains Mono, ui-monospace, monospace"
            >
              {edge.label}
            </text>
          )}
        </g>
      ))}

      {diagram.nodes.map((node) => (
        <g>
          <rect
            x={node.x}
            y={node.y}
            width={node.w}
            height={node.h}
            rx="10"
            class="diagram-node-box"
            stroke-width="1.5"
          />
          <text
            x={node.x + node.w / 2}
            y={node.sublabel ? node.y + node.h / 2 - 4 : node.y + node.h / 2 + 5}
            text-anchor="middle"
            class="diagram-label"
            font-size="14"
            font-weight="700"
            font-family="Inter Variable, system-ui, sans-serif"
          >
            {node.label}
          </text>
          {node.sublabel && (
            <text
              x={node.x + node.w / 2}
              y={node.y + node.h / 2 + 16}
              text-anchor="middle"
              class="diagram-sublabel"
              font-size="11.5"
              font-family="JetBrains Mono, ui-monospace, monospace"
            >
              {node.sublabel}
            </text>
          )}
        </g>
      ))}
    </svg>
  </div>
  <figcaption id={descId} class="sr-only">
    {diagramSummary}
  </figcaption>
</figure>

<script>
  const figures = Array.from(document.querySelectorAll<HTMLElement>('[data-diagram-figure]'));
  const zoomQuery = figures[0]?.dataset.zoomQuery;

  if (figures.length > 0 && zoomQuery) {
    const mq = window.matchMedia(zoomQuery);

    const setInteractive = (figure: HTMLElement, interactive: boolean): void => {
      const host = figure.querySelector<HTMLElement>('[data-diagram-host]');
      const svg = figure.querySelector<SVGSVGElement>('svg.diagram-svg');
      const title = figure.dataset.diagramTitle ?? '';
      const descId = figure.dataset.diagramDesc ?? '';
      if (!host || !svg) return;

      if (interactive && host.tagName !== 'BUTTON') {
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.diagramHost = '';
        button.setAttribute('aria-label', `Zoom diagram: ${title}`);
        if (descId) button.setAttribute('aria-describedby', descId);
        button.className =
          'group block w-full rounded-[24px] bg-surface p-5 text-left transition-colors duration-150 hover:bg-rule/45 active:opacity-85 sm:p-8 md:p-12';

        svg.removeAttribute('aria-describedby');

        const label = document.createElement('span');
        label.className =
          'mt-4 flex justify-end font-mono text-xs text-ink-secondary underline decoration-ink-secondary/60 underline-offset-4 group-hover:text-ink';
        label.textContent = 'Zoom diagram';

        button.append(svg, label);
        button.addEventListener('click', async () => {
          const { openDiagramModal } = await import('../scripts/diagram-modal');
          openDiagramModal(figure);
        });
        host.replaceWith(button);
      } else if (!interactive && host.tagName === 'BUTTON') {
        const openDialog = figure.querySelector<HTMLDialogElement>('dialog.diagram-dialog[open]');
        openDialog?.close();

        const wrapper = document.createElement('div');
        wrapper.dataset.diagramHost = '';
        wrapper.className = 'rounded-[24px] bg-surface p-5 sm:p-8 md:p-12';
        if (descId) svg.setAttribute('aria-describedby', descId);
        wrapper.append(svg);
        host.replaceWith(wrapper);
      }
    };

    const syncZoomMode = (): void => {
      for (const figure of figures) {
        setInteractive(figure, mq.matches);
      }
    };

    syncZoomMode();
    mq.addEventListener('change', syncZoomMode);
  }
</script>
