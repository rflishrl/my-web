---
import type { ArchitectureDiagramData } from '../data/portfolio';
import DiagramViewer from './DiagramViewer.svelte';

interface Props {
  diagram: ArchitectureDiagramData;
}

const { diagram } = Astro.props;
const zoomMediaQuery = '(max-width: 63.999em), (any-pointer: coarse)';
---

<DiagramViewer client:media={zoomMediaQuery} diagram={diagram} zoomMediaQuery={zoomMediaQuery} />
