---
import type { ArchitectureDiagramData } from '../data/portfolio';

interface Props {
  diagram: ArchitectureDiagramData;
}

const { diagram } = Astro.props;
const nodeById = new Map(diagram.nodes.map((node) => [node.id, node]));
const outCountByFrom = new Map<string, number>();
for (const edge of diagram.edges) {
  outCountByFrom.set(edge.from, (outCountByFrom.get(edge.from) ?? 0) + 1);
}
---

<div class="mt-10 rounded-[24px] bg-surface p-5 sm:p-8 md:mt-14 md:p-12">
  <svg
    role="img"
    viewBox={`0 0 ${diagram.width} ${diagram.height}`}
    class="h-auto w-full"
    aria-label={diagram.title}
  >
    <title>{diagram.title}</title>
    <defs>
      <marker
        id={`arrow-${diagram.width}-${diagram.height}`}
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M 0 1 L 10 5 L 0 9 z" fill="#0A0A0A" />
      </marker>
    </defs>

    {diagram.edges.map((edge) => {
      const from = nodeById.get(edge.from);
      const to = nodeById.get(edge.to);
      if (!from || !to) return null;

      const x1 = from.x + from.w;
      const y1 = from.y + from.h / 2;
      const x2 = to.x;
      const y2 = to.y + to.h / 2;
      const isSingleStraight = (outCountByFrom.get(edge.from) ?? 0) === 1 && y1 === y2;
      const midX = isSingleStraight ? Math.round((x1 + x2) / 2) : x1 + 24;
      const labelX = isSingleStraight ? midX : Math.round((midX + x2 - 8) / 2);
      const labelY = y2 - 8;

      return (
        <g>
          <path
            d={`M ${x1} ${y1} L ${midX} ${y1} L ${midX} ${y2} L ${x2} ${y2}`}
            fill="none"
            stroke="#0A0A0A"
            stroke-width="1.5"
            marker-end={`url(#arrow-${diagram.width}-${diagram.height})`}
          />
          {edge.label && (
            <text
              x={labelX}
              y={labelY}
              text-anchor="middle"
              fill="#525252"
              font-size="10.5"
              font-family="JetBrains Mono Variable, ui-monospace, monospace"
            >
              {edge.label}
            </text>
          )}
        </g>
      );
    })}

    {diagram.nodes.map((node) => (
      <g>
        <rect
          x={node.x}
          y={node.y}
          width={node.w}
          height={node.h}
          rx="10"
          fill="#FFFFFF"
          stroke="#0A0A0A"
          stroke-width="1.5"
        />
        <text
          x={node.x + node.w / 2}
          y={node.sublabel ? node.y + node.h / 2 - 4 : node.y + node.h / 2 + 5}
          text-anchor="middle"
          fill="#0A0A0A"
          font-size="14"
          font-weight="700"
          font-family="Inter Variable, system-ui, sans-serif"
        >
          {node.label}
        </text>
        {node.sublabel && (
          <text
            x={node.x + node.w / 2}
            y={node.y + node.h / 2 + 16}
            text-anchor="middle"
            fill="#525252"
            font-size="11.5"
            font-family="JetBrains Mono Variable, ui-monospace, monospace"
          >
            {node.sublabel}
          </text>
        )}
      </g>
    ))}
  </svg>
</div>
