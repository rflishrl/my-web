---
interface NavSection {
  id: string;
  href: string;
  label: string;
  icon: string;
}

const sections: NavSection[] = [
  {
    id: 'hero',
    href: '#hero',
    label: 'Home',
    icon: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5.5v-6h-5v6H4a1 1 0 0 1-1-1z" />',
  },
  {
    id: 'about',
    href: '#about',
    label: 'About',
    icon: '<circle cx="12" cy="8" r="4" /><path d="M4 20c0-3.5 3.6-6 8-6s8 2.5 8 6" />',
  },
  {
    id: 'experience',
    href: '#experience',
    label: 'Experience',
    icon: '<rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /><path d="M3 13h18" />',
  },
  {
    id: 'education',
    href: '#education',
    label: 'Education',
    icon: '<path d="m2 9 10-5 10 5-10 5z" /><path d="M6 11.5v5.5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5.5" /><path d="M22 9v6" />',
  },
  {
    id: 'stack',
    href: '#stack',
    label: 'Stack',
    icon: '<path d="m12 3 9 4.5-9 4.5-9-4.5z" /><path d="m3 12 9 4.5 9-4.5" /><path d="m3 16.5 9 4.5 9-4.5" />',
  },
  {
    id: 'certifications',
    href: '#certifications',
    label: 'Certs',
    icon: '<circle cx="12" cy="9" r="6" /><path d="m8.5 14.2-.5 6.8 4-2 4 2-.5-6.8" />',
  },
  {
    id: 'projects',
    href: '#projects',
    label: 'Projects',
    icon: '<path d="m8 8-5 4 5 4" /><path d="m16 8 5 4-5 4" /><path d="m13.5 5-3 14" />',
  },
  {
    id: 'contact',
    href: '#contact',
    label: 'Contact',
    icon: '<rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />',
  },
];
---

<div class="safe-top-scrim" aria-hidden="true"></div>

<nav id="floating-nav" aria-label="Primary" class="floating-nav">
  <div class="floating-nav-shell">
    <!-- Compact bottom dock for phones (< 640px), triggering the same section list as a popover -->
    <div class="floating-nav-mobile-bar">
      <a href="#hero" class="floating-nav-quick" aria-label="Home" data-mobile-quick="hero">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5.5v-6h-5v6H4a1 1 0 0 1-1-1z" />
        </svg>
      </a>

      <button
        type="button"
        id="floating-nav-trigger"
        class="floating-nav-trigger"
        popovertarget="floating-nav-panel"
        popovertargetaction="toggle"
        aria-controls="floating-nav-panel"
        aria-expanded="false"
      >
        <span class="floating-nav-trigger-dot" aria-hidden="true"></span>
        <span id="floating-nav-current">Home</span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </button>

      <a href="#contact" class="floating-nav-quick" aria-label="Contact" data-mobile-quick="contact">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
      </a>
    </div>

    <!-- Compact active section readout on foldable widths (640px-767px) -->
    <span class="floating-nav-fold-label" aria-hidden="true" data-fold-current>Home</span>

    <!-- Single semantic navigation tree shared across mobile popover, foldables, tablet, and desktop -->
    <div id="floating-nav-panel" class="floating-nav-panel">
      <span class="floating-nav-indicator" aria-hidden="true"></span>
      <ul role="list" class="floating-nav-list">
        {sections.map((item, idx) => (
          <li>
            <a
              href={item.href}
              class="floating-nav-link"
              data-nav-section={item.id}
              aria-label={item.label}
              aria-current={idx === 0 ? 'true' : undefined}
            >
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={item.icon}
              />
              <span class="floating-nav-label">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</nav>

<script>
  import '../scripts/floating-nav';
</script>
