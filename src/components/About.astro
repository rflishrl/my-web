---
import { Picture } from 'astro:assets';
import portraitImg from '../assets/portrait.jpg';
import { portfolio } from '../data/portfolio';
import RunningHeader from './RunningHeader.astro';
---

<section id="about" class="py-16 sm:py-24 md:py-36">
  <div class="container-editorial">
    <RunningHeader right="About me" />

    <div class="about-grid mt-10 grid grid-cols-1 gap-10 md:mt-16 lg:grid-cols-12 lg:items-start lg:gap-12">
      <div class="lg:col-span-5">
        <div class="portrait-frame aspect-[4/5] w-full max-w-[26rem] overflow-hidden rounded-[32px] bg-surface md:rounded-[40px]">
          <Picture
            src={portraitImg}
            formats={['avif', 'webp']}
            widths={[400, 720, 1080]}
            sizes="(max-width: 1023px) min(92vw, 26rem), 26rem"
            alt={portfolio.portraitAlt}
            loading="lazy"
            decoding="async"
            pictureAttributes={{ class: 'block h-full w-full' }}
            class="portrait-image h-full w-full object-cover object-top mix-blend-multiply"
          />
        </div>
      </div>

      <div class="lg:col-span-7">
        <h2 id="about-heading" class="text-section font-normal text-ink">
          <span class="block font-bold">Hello!</span>
          <span class="block font-light">I'm {portfolio.displayName}</span>
        </h2>

        <div class="mt-8 space-y-5 text-base leading-[1.6] text-ink">
          {portfolio.bio.map((paragraph) => (
            <p class="max-w-[56ch]">{paragraph}</p>
          ))}
        </div>

        <dl class="mt-10 grid max-w-[56ch] grid-cols-1 gap-y-4 border-t border-rule pt-6 sm:grid-cols-3 sm:gap-x-6">
          <div>
            <dt class="text-sm text-ink-secondary">Current focus</dt>
            <dd class="mt-1 text-sm text-ink">{portfolio.currentFocus}</dd>
          </div>
          <div>
            <dt class="text-sm text-ink-secondary">Location</dt>
            <dd class="mt-1 text-sm text-ink">{portfolio.location}</dd>
          </div>
          {portfolio.availability && (
            <div>
              <dt class="text-sm text-ink-secondary">Availability</dt>
              <dd class="mt-1 text-sm text-ink">{portfolio.availability}</dd>
            </div>
          )}
        </dl>
      </div>
    </div>
  </div>
</section>
