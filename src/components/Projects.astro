---
import { portfolio } from '../data/portfolio';
import RunningHeader from './RunningHeader.astro';
import ProjectArticle from './ProjectArticle.astro';

const featuredProjects = portfolio.projects.filter((project) => project.featured);
const featuredCountLabel = String(featuredProjects.length).padStart(2, '0');
const totalProjects = portfolio.projects.length;
---

<section id="projects" class="py-16 sm:py-24 md:py-36">
  <div class="container-editorial">
    <RunningHeader right={`01 — ${featuredCountLabel} Selected Works`} />
    <h2 id="projects-heading" class="sr-only">
      Selected projects
    </h2>

    <div class="mt-10 space-y-20 md:mt-16 md:space-y-32">
      {featuredProjects.map((project, idx) => (
        <ProjectArticle project={project} showDivider={idx > 0} headingLevel="h3" />
      ))}
    </div>

    {totalProjects > featuredProjects.length && (
      <div class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-rule pt-8 md:mt-24 md:pt-10">
        <p class="font-mono text-sm text-ink-secondary">
          Showing {featuredProjects.length} of {totalProjects} projects
        </p>
        <a
          href="/projects"
          class="btn-frame inline-flex min-h-[44px] items-center border border-ink-secondary px-5 text-sm text-ink transition-colors duration-150 hover:border-ink hover:bg-ink hover:text-ink-inverse active:opacity-75"
        >
          View all {totalProjects} projects
        </a>
      </div>
    )}
  </div>
</section>
