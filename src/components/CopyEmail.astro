---
interface Props {
  email: string;
  label?: string;
  inverse?: boolean;
}

const { email, label = 'Copy email', inverse = false } = Astro.props;
---

<button
  type="button"
  hidden
  data-copy-email={email}
  data-default-label={label}
  class:list={[
    'inline-flex min-h-[44px] items-center border px-3 text-sm transition-colors duration-150 active:opacity-75',
    inverse
      ? 'border-ink-inverse-muted text-ink-inverse hover:border-ink-inverse hover:bg-ink-inverse hover:text-inverse'
      : 'border-ink-secondary text-ink hover:border-ink hover:bg-ink hover:text-ink-inverse',
  ]}
>
  {label}
</button>
