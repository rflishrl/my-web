---
import { portfolio } from '../data/portfolio';
import RunningHeader from './RunningHeader.astro';
import CopyEmail from './CopyEmail.svelte';

const now = new Date();
const buildMonthYear = new Intl.DateTimeFormat('en-GB', {
  month: 'long',
  year: 'numeric',
  timeZone: 'Asia/Jakarta',
}).format(now);
const buildIsoMonth = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: '2-digit',
  timeZone: 'Asia/Jakarta',
}).format(now);
---

<footer
  id="contact"
  class="flex min-h-[85svh] flex-col justify-between bg-inverse py-10 text-ink-inverse sm:py-14"
>
  <div class="container-editorial">
    <RunningHeader right={buildMonthYear} isoMonth={buildIsoMonth} liveMonthYear inverse />

    <h2 class="mt-16 text-display text-ink-inverse md:mt-24">
      <span class="block">Let's start</span>
      <span class="block">something!</span>
    </h2>
  </div>

  <div class="container-editorial contact-bottom mt-20 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
    <ul role="list" class="flex flex-col items-start gap-1 text-sm">
      {portfolio.profiles.map((profile) => (
        <li>
          <a
            href={profile.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[44px] items-center text-ink-inverse underline decoration-ink-inverse-muted/60 underline-offset-4 transition-colors duration-150 hover:text-ink-inverse-muted active:opacity-75"
          >
            {profile.label}
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
      <span class="text-ink-inverse-muted">e-mail:</span>
      <a
        href={`mailto:${portfolio.email}`}
        class="inline-flex min-h-[44px] items-center text-ink-inverse underline decoration-ink-inverse-muted/60 underline-offset-4 transition-colors duration-150 hover:text-ink-inverse-muted active:opacity-75"
      >
        {portfolio.email}
      </a>
      <CopyEmail client:idle email={portfolio.email} label="Copy email" inverse />
    </div>
  </div>
</footer>
