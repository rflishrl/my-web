---
import NavMenu from './NavMenu.astro';
import { getNavLinks, type NavPage } from '../data/nav';

interface Props {
  homePrefix?: string;
  currentPage?: NavPage;
}

const { homePrefix = '', currentPage = 'home' } = Astro.props;
const navLinks = getNavLinks(homePrefix, currentPage);
const compactMediaQuery = '(22.5em <= width < 40em) and (height >= 37.5em)';
---

<header class="site-header" id="top">
  <nav class="site-nav" aria-label="Primary">
    <ul class="nav-full">
      {navLinks.map((item) => (
        <li>
          <a href={item.href} aria-current={item.current ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="nav-compact">
      <NavMenu links={navLinks} compactMediaQuery={compactMediaQuery} />
    </div>
  </nav>
</header>

{currentPage === 'home' && <script>
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.nav-full a, .nav-links a'),
  );
  let lastHref: string | null = null;
  const setActiveHref = (href: string | null, toggleClass: boolean): void => {
    if (href === lastHref) return;
    lastHref = href;
    for (const link of navLinks) {
      const isActive = href !== null && link.getAttribute('href') === href;
      if (toggleClass) {
        link.classList.toggle('target-current', isActive);
      }
      if (isActive) {
        link.setAttribute('aria-current', 'true');
      } else {
        link.removeAttribute('aria-current');
      }
    }
  };

  if (CSS.supports('scroll-target-group: auto')) {
    const syncAriaCurrent = (): void => {
      const currentLink = document.querySelector<HTMLAnchorElement>(
        '.nav-full a:target-current, .nav-links a:target-current',
      );
      setActiveHref(currentLink ? currentLink.getAttribute('href') : null, false);
    };
    syncAriaCurrent();
    document.addEventListener('scrollend', syncAriaCurrent, { passive: true });
    window.addEventListener('hashchange', syncAriaCurrent);
  } else {
    const sections = document.querySelectorAll<HTMLElement>('main section[id], footer[id]');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActiveHref(`#${entry.target.id}`, true);
          }
        }
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
    );
    for (const section of sections) {
      observer.observe(section);
    }
  }
</script>}
