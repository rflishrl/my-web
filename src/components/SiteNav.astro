---
const navItems = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#education', label: 'Education' },
  { href: '#stack', label: 'Stack' },
  { href: '#certifications', label: 'Certifications' },
  { href: '#projects', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];
---

<nav aria-label="Primary" class="mt-3 sm:mt-4">
  <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 sm:gap-x-7">
    {navItems.map((item) => (
      <li>
        <a
          href={item.href}
          class="inline-flex min-h-[44px] items-center text-sm text-ink-secondary transition-colors duration-150 hover:text-ink active:opacity-75"
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
