---
import { portfolio } from '../data/portfolio';
import RunningHeader from './RunningHeader.astro';
---

<section id="certifications" class="py-16 sm:py-24 md:py-36">
  <div class="container-editorial">
    <RunningHeader right="Certifications" />

    <h2 id="certifications-heading" class="mt-10 text-section text-ink md:mt-16">
      Certifications
    </h2>

    <ol role="list" class="timeline-list mt-10 divide-y divide-rule border-y border-rule md:mt-14">
      {portfolio.certifications.map((cert) => (
        <li class="grid grid-cols-1 gap-3 py-7 md:grid-cols-12 md:items-baseline md:gap-8 md:py-8">
          <div class="md:col-span-3">
            <span class="font-mono text-sm text-ink-secondary">{cert.index}</span>
          </div>

          <div class="md:col-span-5">
            <h3 class="text-lg font-bold leading-snug text-ink">{cert.title}</h3>
          </div>

          <div class="md:col-span-4">
            {cert.issuer && <p class="text-base text-ink-secondary">{cert.issuer}</p>}
            {cert.subtitle && <p class="text-base text-ink-secondary">{cert.subtitle}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
