---
import { portfolio } from '../data/portfolio';
import RunningHeader from './RunningHeader.astro';
---

<section id="education" class="py-16 sm:py-24 md:py-36">
  <div class="container-editorial">
    <RunningHeader right="Education" />

    <h2 id="education-heading" class="mt-10 text-section text-ink md:mt-16">
      Education
    </h2>

    <ol role="list" class="timeline-list mt-10 divide-y divide-rule border-y border-rule md:mt-14">
      {portfolio.education.map((item) => (
        <li class="grid grid-cols-1 gap-4 py-8 md:grid-cols-12 md:gap-8 md:py-10">
          <div class="md:col-span-3">
            <p class="font-mono text-sm text-ink-secondary">{item.period}</p>
          </div>

          <div class="md:col-span-4">
            <h3 class="text-lg font-bold leading-snug text-ink">{item.program}</h3>
            <p class="mt-1 text-base text-ink-secondary">{item.institution}</p>
          </div>

          <div class="md:col-span-5">
            {item.gpa && <p class="font-mono text-sm text-ink">{item.gpa}</p>}
            {item.honors && item.honors.length > 0 && (
              <ul
                class:list={[
                  'list-disc space-y-1.5 pl-5 text-base leading-[1.6] text-ink',
                  item.gpa && 'mt-2',
                ]}
              >
                {item.honors.map((honor) => (
                  <li>{honor}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
