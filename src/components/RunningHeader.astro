---
import { portfolio } from '../data/portfolio';

interface Props {
  right: string;
  inverse?: boolean;
}

const { right, inverse = false } = Astro.props;
---

<div
  class:list={[
    'flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-sm',
    inverse ? 'text-ink-inverse-muted' : 'text-ink-secondary',
  ]}
>
  <span>{portfolio.displayName} | Portfolio</span>
  <span>{right}</span>
</div>
