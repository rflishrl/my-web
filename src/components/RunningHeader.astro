---
import { portfolio } from '../data/portfolio';

interface Props {
  right: string;
  inverse?: boolean;
  liveMonthYear?: boolean;
  isoMonth?: string;
}

const { right, inverse = false, liveMonthYear = false, isoMonth } = Astro.props;
---

<div
  class:list={[
    'running-header flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-sm',
    inverse ? 'running-header-inverse text-ink-inverse-muted' : 'text-ink-secondary',
  ]}
>
  <span>{portfolio.displayName} | Portfolio</span>
  {liveMonthYear ? (
    <time class="section-name" datetime={isoMonth} data-live-month-year>
      {right}
    </time>
  ) : (
    <span class="section-name">{right}</span>
  )}
  <span class="back-to-top">
    <a href="#top">Back to top</a>
  </span>
</div>
