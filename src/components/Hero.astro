---
import fs from 'node:fs';
import path from 'node:path';
import { portfolio } from '../data/portfolio';
import { formatPortfolioDate } from '../utils/date';
import CopyEmail from './CopyEmail.astro';

const {
  year: buildYear,
  monthYear: buildMonthYear,
  isoMonth: buildIsoMonth,
} = formatPortfolioDate();

const resumeExists = fs.existsSync(path.join(process.cwd(), 'public/resume.pdf'));
---

<section
  id="hero"
  class="first-section flex flex-col justify-between pt-6 pb-6 sm:pt-8 sm:pb-8 lg:pt-8 lg:pb-6"
>
  <div class="container-editorial hero-stagger-1">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-sm text-ink-secondary">
      <span>
        Selected Works · <span data-live-year>{buildYear}</span>
      </span>
      <time datetime={buildIsoMonth} data-live-month-year>
        {buildMonthYear}
      </time>
    </div>
  </div>

  <div class="container-editorial mt-auto pt-12 sm:pt-16 lg:pt-32">
    <div class="hero-stagger-2 relative z-10 mb-6 flex flex-col gap-3 sm:mb-8 sm:flex-row sm:items-end sm:justify-between">
      <p class="text-sm font-normal text-ink sm:text-base">{portfolio.headline}</p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
        <a href={`mailto:${portfolio.email}`} class="link-inline">
          Email
        </a>
        <CopyEmail email={portfolio.email} label="Copy email" />
        {portfolio.profiles.map((profile) => (
          <a href={profile.url} target="_blank" rel="noopener noreferrer" class="link-inline">
            {profile.label}
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        ))}
        {resumeExists && (
          <a href="/resume.pdf" class="link-inline">
            Resume (PDF)
          </a>
        )}
      </div>
    </div>

    <h1 class="hero-wordmark hero-stagger-3 text-ink">
      <span class="wm-line">Rafli</span> <span class="wm-line">Sahrul</span>
    </h1>
  </div>
</section>
