---
import fs from 'node:fs';
import path from 'node:path';
import { portfolio } from '../data/portfolio';
import SiteNav from './SiteNav.astro';
import CopyEmail from './CopyEmail.astro';

const now = new Date();
const buildYear = now.getFullYear();
const buildMonthYear = new Intl.DateTimeFormat('en-GB', {
  month: 'long',
  year: 'numeric',
  timeZone: 'Asia/Jakarta',
}).format(now);

const resumeExists = fs.existsSync(path.join(process.cwd(), 'public/resume.pdf'));
---

<header id="hero" class="min-h-[100svh] flex flex-col justify-between pt-6 pb-6 sm:pt-8 sm:pb-8 lg:pt-8 lg:pb-6">
  <div class="container-editorial hero-stagger-1">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-sm text-ink-secondary">
      <span>Selected Works · {buildYear}</span>
      <span>{buildMonthYear}</span>
    </div>
    <SiteNav />
  </div>

  <div class="container-editorial mt-auto pt-12 sm:pt-16 lg:pt-32">
    <div class="hero-stagger-2 relative z-10 mb-6 flex flex-col gap-3 sm:mb-8 sm:flex-row sm:items-end sm:justify-between">
      <p class="text-sm font-normal text-ink sm:text-base">{portfolio.headline}</p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
        <a
          href={`mailto:${portfolio.email}`}
          class="inline-flex min-h-[44px] items-center text-ink underline decoration-ink-secondary/60 underline-offset-4 transition-colors duration-150 hover:text-ink-secondary active:opacity-75"
        >
          Email
        </a>
        <CopyEmail email={portfolio.email} label="Copy email" />
        {portfolio.profiles.map((profile) => (
          <a
            href={profile.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[44px] items-center text-ink underline decoration-ink-secondary/60 underline-offset-4 transition-colors duration-150 hover:text-ink-secondary active:opacity-75"
          >
            {profile.label}<span class="sr-only"> (opens in a new tab)</span>
          </a>
        ))}
        {resumeExists && (
          <a
            href="/resume.pdf"
            class="inline-flex min-h-[44px] items-center text-ink underline decoration-ink-secondary/60 underline-offset-4 transition-colors duration-150 hover:text-ink-secondary active:opacity-75"
          >
            Resume (PDF)
          </a>
        )}
      </div>
    </div>

    <h1 class="hero-wordmark hero-stagger-3 text-ink">
      <span class="wm-line">Rafli</span> <span class="wm-line">Sahrul</span>
    </h1>
  </div>
</header>
